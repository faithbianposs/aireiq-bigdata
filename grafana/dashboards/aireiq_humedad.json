{
  "uid": "aireiq-vivo",
  "title": "AireIQ · Humedad y predicción real",
  "schemaVersion": 39,
  "version": 2,
  "timezone": "America/Lima",
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
